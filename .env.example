# Copy to .env.local. Only VITE_* variables reach the browser — never put
# secrets (Higgsfield, ElevenLabs keys) in a VITE_ variable.

# Where "real" links (gallery, about, contact) send visitors.
VITE_MAIN_SITE_URL=https://kenchogroup.ge

# Server-side / tooling only (generation scripts), never imported by src/.
HF_CREDENTIALS=
ELEVENLABS_API_KEY=
